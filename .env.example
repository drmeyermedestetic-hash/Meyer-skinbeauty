# Meyer SkinBeauty — variables de entorno
# Copiá este archivo a .env.local y cargá los valores reales.
# NUNCA commitear .env.local (ya está en .gitignore).

# URL pública del sitio (sin barra final). Se usa para las back_urls
# y la notification_url de Mercado Pago.
NEXT_PUBLIC_SITE_URL=https://meyerskinbeauty.com

# --- Supabase ---------------------------------------------------
# Project Settings → API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SOLO server-side. Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago -------------------------------------------------
# Credenciales de producción o de prueba desde
# https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto de la firma del webhook (panel de Mercado Pago → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=
